# ─── Estágio 1: build com Maven ───────────────────────────────────────────────
# Imagem oficial do Maven com JDK 17 — não depende do Maven Wrapper (.mvn/mvnw)
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /app
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
# Copia o pom antes do código para aproveitar o cache de dependências
COPY pom.xml ./
RUN mvn dependency:resolve

# Copia o código-fonte e compila (--no-transfer-progress reduz spam mas mantém erros visíveis)
COPY src ./src
RUN mvn package -DskipTests --no-transfer-progress

# ─── Estágio 2: runtime ───────────────────────────────────────────────────────
FROM eclipse-temurin:17-jre-alpine AS runner
WORKDIR /app

# Usuário não-root
RUN addgroup --system --gid 1001 spring \
 && adduser  --system --uid 1001 --ingroup spring springuser

COPY --from=builder /app/target/*.jar app.jar

USER springuser

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]